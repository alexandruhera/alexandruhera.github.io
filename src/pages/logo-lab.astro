---
// SCRATCH PAGE — logo exploration v2. Not linked from nav.
// DELETE before launch (or keep as an easter egg — but unlist in sitemap).
// Keepers from v1: hex monogram + handle. Below them: advanced explorations.
import Base from "../layouts/Base.astro";
---

<Base title="Logo lab" description="Personal logo exploration — scratch page.">
  <h1>Logo lab <span class="mono-label">v2</span></h1>
  <p class="mono-label">keepers on top · six advanced explorations below · toggle ◐ to check both schemes</p>

  <!-- KEEPER A: hex monogram -->
  <section class="variant keeper">
    <h2>K1 — Hex monogram <span class="tag">keeper</span></h2>
    <div class="stage">
      <svg class="hero-size" viewBox="0 0 44 48" xmlns="http://www.w3.org/2000/svg" aria-label="AH hexagon">
        <path d="M22 2 L41 13 L41 35 L22 46 L3 35 L3 13 Z" fill="none" class="stroke-accent" stroke-width="2.5"/>
        <text x="22" y="30" text-anchor="middle" class="svg-mono fg" font-size="14" letter-spacing="3">AH</text>
      </svg>
    </div>
  </section>

  <!-- KEEPER B: handle -->
  <section class="variant keeper">
    <h2>K2 — Handle <span class="tag">keeper</span></h2>
    <div class="stage">
      <div class="hero-size handle-demo">alexandru<span class="accent">_</span>hera</div>
    </div>
  </section>

  <!-- 1. Full lockup: hex + handle -->
  <section class="variant">
    <h2>1 — Lockup: hex + handle</h2>
    <p class="note">Symbol for favicons/avatars, handle for the nav — one system.</p>
    <div class="stage">
      <div class="lockup">
        <svg viewBox="0 0 44 48" xmlns="http://www.w3.org/2000/svg" class="lockup-hex">
          <path d="M22 2 L41 13 L41 35 L22 46 L3 35 L3 13 Z" fill="none" class="stroke-accent" stroke-width="3"/>
          <text x="22" y="30" text-anchor="middle" class="svg-mono fg" font-size="13" letter-spacing="2">AH</text>
        </svg>
        <span class="handle-demo">alexandru<span class="accent">_</span>hera</span>
      </div>
    </div>
  </section>

  <!-- 2. Hex-glyph handle -->
  <section class="variant">
    <h2>2 — Hex-glyph handle</h2>
    <p class="note">The hexagon *becomes* the separator — replaces the underscore.</p>
    <div class="stage">
      <div class="handle-demo hero-size" style="display:flex;align-items:center;gap:0.35rem;">
        alexandru
        <svg width="20" height="22" viewBox="0 0 44 48" xmlns="http://www.w3.org/2000/svg">
          <path d="M22 2 L41 13 L41 35 L22 46 L3 35 L3 13 Z" fill="none" class="stroke-accent" stroke-width="4.5"/>
        </svg>
        hera
      </div>
    </div>
  </section>

  <!-- 3. Circuit hex -->
  <section class="variant">
    <h2>3 — Circuit hex</h2>
    <p class="note">Vertex nodes + traces to core: infrastructure/board aesthetic.</p>
    <div class="stage">
      <svg class="hero-size-lg" viewBox="0 0 48 52" xmlns="http://www.w3.org/2000/svg" aria-label="circuit hexagon AH">
        <path d="M24 3 L43 14 L43 38 L24 49 L5 38 L5 14 Z" fill="none" class="stroke-fg" stroke-width="1.6"/>
        <g class="stroke-border-c">
          <line x1="24" y1="3" x2="24" y2="14"/>
          <line x1="43" y1="14" x2="34" y2="19.5"/>
          <line x1="43" y1="38" x2="34" y2="32.5"/>
          <line x1="24" y1="49" x2="24" y2="38"/>
          <line x1="5" y1="38" x2="14" y2="32.5"/>
          <line x1="5" y1="14" x2="14" y2="19.5"/>
        </g>
        <g class="fill-accent">
          <circle cx="24" cy="3" r="2.4"/>
          <circle cx="43" cy="14" r="2.4"/>
          <circle cx="43" cy="38" r="2.4"/>
          <circle cx="24" cy="49" r="2.4"/>
          <circle cx="5" cy="38" r="2.4"/>
          <circle cx="5" cy="14" r="2.4"/>
        </g>
        <text x="24" y="31" text-anchor="middle" class="svg-mono fg" font-size="13" letter-spacing="2.5">AH</text>
      </svg>
    </div>
  </section>

  <!-- 4. Radar hex -->
  <section class="variant">
    <h2>4 — Radar hex <span class="tag tag-anim">animated</span></h2>
    <p class="note">Detection made literal: sweep line + inner rings. Sweep pauses under reduced-motion.</p>
    <div class="stage">
      <svg class="hero-size-lg" viewBox="0 0 48 52" xmlns="http://www.w3.org/2000/svg" aria-label="radar hexagon">
        <path d="M24 3 L43 14 L43 38 L24 49 L5 38 L5 14 Z" fill="none" class="stroke-accent" stroke-width="2"/>
        <path d="M24 12 L36.5 19 L36.5 33 L24 40 L11.5 33 L11.5 19 Z" fill="none" class="stroke-border-c" stroke-width="1.2"/>
        <path d="M24 20 L30 23.5 L30 30.5 L24 34 L18 30.5 L18 23.5 Z" fill="none" class="stroke-border-c" stroke-width="1"/>
        <g class="sweep">
          <line x1="24" y1="26" x2="24" y2="5" class="stroke-accent" stroke-width="1.6"/>
          <circle cx="24" cy="8" r="1.6" class="fill-accent"/>
        </g>
        <circle cx="24" cy="26" r="1.8" class="fill-fg"/>
      </svg>
    </div>
  </section>

  <!-- 5. AH strut ligature -->
  <section class="variant">
    <h2>5 — Strut ligature</h2>
    <p class="note">A and H share one stem, drawn like structural bracing inside the hex. Custom letterforms, no font.</p>
    <div class="stage">
      <svg class="hero-size-lg" viewBox="0 0 48 52" xmlns="http://www.w3.org/2000/svg" aria-label="AH ligature hexagon">
        <path d="M24 3 L43 14 L43 38 L24 49 L5 38 L5 14 Z" fill="none" class="stroke-fg" stroke-width="1.6"/>
        <g fill="none" stroke-linecap="round">
          <path d="M12 36 L20 16" class="stroke-fg-2"/>
          <path d="M28 16 L28 36" class="stroke-fg-2"/>
          <path d="M36 16 L36 36" class="stroke-fg-2"/>
          <path d="M20 16 L28 36" class="stroke-fg-2"/>
          <path d="M15.2 28 L24.8 28" class="stroke-accent-2"/>
          <path d="M28 26 L36 26" class="stroke-accent-2"/>
        </g>
      </svg>
    </div>
  </section>

  <!-- 6. Offset echo hex -->
  <section class="variant">
    <h2>6 — Echo hex</h2>
    <p class="note">Double-exposure offset: fg hex + accent echo. Depth without gradients; reads as motion/signal.</p>
    <div class="stage">
      <svg class="hero-size-lg" viewBox="0 0 52 54" xmlns="http://www.w3.org/2000/svg" aria-label="echo hexagon AH">
        <path d="M27 6 L45 16.5 L45 37.5 L27 48 L9 37.5 L9 16.5 Z" fill="none" class="stroke-accent" stroke-width="2" opacity="0.55"/>
        <path d="M24 3 L42 13.5 L42 34.5 L24 45 L6 34.5 L6 13.5 Z" fill="none" class="stroke-fg" stroke-width="2.2"/>
        <text x="24" y="28.5" text-anchor="middle" class="svg-mono fg" font-size="13" letter-spacing="2.5">AH</text>
      </svg>
    </div>
  </section>
</Base>

<style>
  .variant {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0 2rem;
  }

  .keeper { padding: 1rem 0 1.2rem; }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: var(--radius);
    padding: 0.1rem 0.4rem;
    vertical-align: middle;
  }

  .tag-anim { border-color: var(--fg-muted); color: var(--fg-muted); }

  .note {
    color: var(--fg-muted);
    font-size: 0.85rem;
  }

  .stage {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .hero-size { height: 3rem; }
  .hero-size-lg { height: 4.5rem; }

  .svg-mono { font-family: var(--font-mono); font-weight: 600; }
  .fg { fill: var(--fg); }
  .accent { color: var(--accent); }
  .fill-accent { fill: var(--accent); }
  .fill-fg { fill: var(--fg); }
  .stroke-accent { stroke: var(--accent); }
  .stroke-fg { stroke: var(--fg); }
  .stroke-fg-2 { stroke: var(--fg); stroke-width: 2.6; }
  .stroke-accent-2 { stroke: var(--accent); stroke-width: 2.6; }
  .stroke-border-c { stroke: var(--fg-muted); stroke-width: 1; }

  .handle-demo {
    font-family: var(--font-mono);
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: inline-flex;
    align-items: center;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .lockup-hex { height: 2.6rem; }

  .sweep {
    transform-origin: 24px 26px;
    animation: sweep 4s linear infinite;
  }

  @keyframes sweep {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sweep { animation: none; }
  }
</style>
