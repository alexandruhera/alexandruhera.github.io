---
// SCRATCH PAGE — logo exploration v3: brand-mark grade concepts.
// Not linked from nav. DELETE before launch.
import Base from "../layouts/Base.astro";
---

<Base title="Logo lab" description="Personal logo exploration — scratch page.">
  <h1>Logo lab <span class="mono-label">v3 — identity grade</span></h1>
  <p class="mono-label">five constructed marks · each with full lockup · toggle ◐ for both schemes</p>

  <!-- 1. FACET — isometric cube inside hex -->
  <section class="variant">
    <h2>1 — Facet</h2>
    <p class="note">
      The hexagon resolved as an isometric cube: three tonal faces, depth without
      gradients. Reads as "structure / building blocks" — enterprise-safe, distinctive at any size.
    </p>
    <div class="stage">
      <svg class="mark-lg" viewBox="0 0 48 52" xmlns="http://www.w3.org/2000/svg" aria-label="Facet mark">
        <path d="M24 5 L42.2 15.5 L42.2 36.5 L24 47 L5.8 36.5 L5.8 15.5 Z" fill="none" class="stroke-fg" stroke-width="1.4"/>
        <path d="M24 5 L42.2 15.5 L24 26 L5.8 15.5 Z" class="face-top"/>
        <path d="M5.8 15.5 L24 26 L24 47 L5.8 36.5 Z" class="face-left"/>
        <path d="M42.2 15.5 L42.2 36.5 L24 47 L24 26 Z" class="face-right"/>
      </svg>
      <div class="lockup-stack">
        <svg class="mark-sm" viewBox="0 0 48 52" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 5 L42.2 15.5 L24 26 L5.8 15.5 Z" class="face-top"/>
          <path d="M5.8 15.5 L24 26 L24 47 L5.8 36.5 Z" class="face-left"/>
          <path d="M42.2 15.5 L42.2 36.5 L24 47 L24 26 Z" class="face-right"/>
        </svg>
        <div class="wordmark-block">
          <span class="wm-name">ALEXANDRU HERA</span>
          <span class="wm-desc">SECURITY OPERATIONS</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. APERTURE — rotated concentric hexes -->
  <section class="variant">
    <h2>2 — Aperture</h2>
    <p class="note">
      Concentric hexagons with rotational offset — vault door / camera aperture.
      Layered precision; the accent core is the "eye". Security connotation without a shield cliché.
    </p>
    <div class="stage">
      <svg class="mark-lg" viewBox="0 0 52 56" xmlns="http://www.w3.org/2000/svg" aria-label="Aperture mark">
        <g fill="none">
          <path d="M26 4 L45.9 15.5 L45.9 38.5 L26 50 L6.1 38.5 L6.1 15.5 Z" class="stroke-fg" stroke-width="1.8"/>
          <g transform="rotate(10 26 27)">
            <path d="M26 10 L40.7 18.5 L40.7 35.5 L26 44 L11.3 35.5 L11.3 18.5 Z" class="stroke-fg" stroke-width="1.3" opacity="0.65"/>
          </g>
          <g transform="rotate(20 26 27)">
            <path d="M26 16 L35.5 21.5 L35.5 32.5 L26 38 L16.5 32.5 L16.5 21.5 Z" class="stroke-fg" stroke-width="1" opacity="0.4"/>
          </g>
          <g transform="rotate(30 26 27)">
            <path d="M26 21.2 L31 24.1 L31 29.9 L26 32.8 L21 29.9 L21 24.1 Z" class="stroke-accent" stroke-width="2.2"/>
          </g>
        </g>
      </svg>
      <div class="lockup-stack">
        <svg class="mark-sm" viewBox="0 0 52 56" xmlns="http://www.w3.org/2000/svg">
          <g fill="none">
            <path d="M26 4 L45.9 15.5 L45.9 38.5 L26 50 L6.1 38.5 L6.1 15.5 Z" class="stroke-fg" stroke-width="2.4"/>
            <g transform="rotate(30 26 27)">
              <path d="M26 16 L35.5 21.5 L35.5 32.5 L26 38 L16.5 32.5 L16.5 21.5 Z" class="stroke-accent" stroke-width="3"/>
            </g>
          </g>
        </svg>
        <div class="wordmark-block">
          <span class="wm-name">ALEXANDRU HERA</span>
          <span class="wm-desc">SECURITY OPERATIONS</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. LATTICE — geodesic hexagram -->
  <section class="variant">
    <h2>3 — Lattice</h2>
    <p class="note">
      Fine-line geodesic construction — every vertex braced, one accent triangle carrying
      the eye. Engineering-drawing texture; premium at large sizes, simplifies to hex+triangle when small.
    </p>
    <div class="stage">
      <svg class="mark-lg" viewBox="0 0 52 56" xmlns="http://www.w3.org/2000/svg" aria-label="Lattice mark">
        <g fill="none">
          <path d="M26 4 L45.9 15.5 L45.9 38.5 L26 50 L6.1 38.5 L6.1 15.5 Z" class="stroke-fg" stroke-width="1.7"/>
          <path d="M26 4 L45.9 38.5 L6.1 38.5 Z" class="stroke-fg" stroke-width="0.9" opacity="0.55"/>
          <path d="M26 50 L6.1 15.5 L45.9 15.5 Z" class="stroke-fg" stroke-width="0.9" opacity="0.55"/>
          <path d="M26 4 L26 50 M6.1 15.5 L45.9 38.5 M45.9 15.5 L6.1 38.5" class="stroke-fg" stroke-width="0.55" opacity="0.3"/>
          <path d="M26 19.2 L32.6 30.7 L19.4 30.7 Z" class="stroke-accent" stroke-width="2" fill="none"/>
        </g>
      </svg>
      <div class="lockup-stack">
        <svg class="mark-sm" viewBox="0 0 52 56" xmlns="http://www.w3.org/2000/svg">
          <g fill="none">
            <path d="M26 4 L45.9 15.5 L45.9 38.5 L26 50 L6.1 38.5 L6.1 15.5 Z" class="stroke-fg" stroke-width="2.4"/>
            <path d="M26 19.2 L32.6 30.7 L19.4 30.7 Z" class="stroke-accent" stroke-width="2.8"/>
          </g>
        </svg>
        <div class="wordmark-block">
          <span class="wm-name">ALEXANDRU HERA</span>
          <span class="wm-desc">SECURITY OPERATIONS</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. KEYSTONE — solid hex, knockout monogram -->
  <section class="variant">
    <h2>4 — Keystone</h2>
    <p class="note">
      Solid mass with the monogram reversed out — the heaviest, most corporate of the set.
      Geometric AH ligature: shared stem, aligned crossbars. Strong avatar/stamp presence.
    </p>
    <div class="stage">
      <svg class="mark-lg" viewBox="0 0 48 52" xmlns="http://www.w3.org/2000/svg" aria-label="Keystone mark">
        <path d="M24 3 L43 14 L43 38 L24 49 L5 38 L5 14 Z" class="fill-solid"/>
        <g fill="none" class="stroke-knockout" stroke-width="2.8" stroke-linecap="square">
          <path d="M12.5 34 L19 18"/>
          <path d="M19 18 L25.5 34"/>
          <path d="M15.1 28.6 L23 28.6"/>
          <path d="M29 18 L29 34"/>
          <path d="M36 18 L36 34"/>
          <path d="M29 25.4 L36 25.4"/>
        </g>
        <path d="M24 3 L43 14 L43 38 L24 49 L5 38 L5 14 Z" fill="none" class="stroke-accent" stroke-width="1.4"/>
      </svg>
      <div class="lockup-stack">
        <svg class="mark-sm" viewBox="0 0 48 52" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 3 L43 14 L43 38 L24 49 L5 38 L5 14 Z" class="fill-solid"/>
          <g fill="none" class="stroke-knockout" stroke-width="3.4" stroke-linecap="square">
            <path d="M12.5 34 L19 18"/>
            <path d="M19 18 L25.5 34"/>
            <path d="M15.1 28.6 L23 28.6"/>
            <path d="M29 18 L29 34"/>
            <path d="M36 18 L36 34"/>
            <path d="M29 25.4 L36 25.4"/>
          </g>
        </svg>
        <div class="wordmark-block">
          <span class="wm-name">ALEXANDRU HERA</span>
          <span class="wm-desc">SECURITY OPERATIONS</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. SIGNAL — evolved circuit, asymmetric -->
  <section class="variant">
    <h2>5 — Signal</h2>
    <p class="note">
      The circuit idea matured: open-segment hexagon (a deliberate break in the perimeter),
      asymmetric traces, weighted nodes. Designed, not decorated — motion implied, nothing animated.
    </p>
    <div class="stage">
      <svg class="mark-lg" viewBox="0 0 52 56" xmlns="http://www.w3.org/2000/svg" aria-label="Signal mark">
        <g fill="none" stroke-linecap="round">
          <path d="M26 4 L45.9 15.5 L45.9 38.5 L26 50 L6.1 38.5 L6.1 21" class="stroke-fg" stroke-width="2.2"/>
          <path d="M6.1 15.5 L26 4" class="stroke-accent" stroke-width="2.2"/>
          <path d="M26 27 L26 12 M26 27 L38 34 M26 27 L14.5 33.5" class="stroke-fg" stroke-width="1.1" opacity="0.5"/>
        </g>
        <circle cx="26" cy="27" r="3.2" class="fill-accent"/>
        <circle cx="26" cy="12" r="1.7" class="fill-fg"/>
        <circle cx="38" cy="34" r="1.7" class="fill-fg"/>
        <circle cx="14.5" cy="33.5" r="1.7" class="fill-fg" opacity="0.6"/>
      </svg>
      <div class="lockup-stack">
        <svg class="mark-sm" viewBox="0 0 52 56" xmlns="http://www.w3.org/2000/svg">
          <g fill="none" stroke-linecap="round">
            <path d="M26 4 L45.9 15.5 L45.9 38.5 L26 50 L6.1 38.5 L6.1 21" class="stroke-fg" stroke-width="2.8"/>
            <path d="M6.1 15.5 L26 4" class="stroke-accent" stroke-width="2.8"/>
          </g>
          <circle cx="26" cy="27" r="4" class="fill-accent"/>
        </svg>
        <div class="wordmark-block">
          <span class="wm-name">ALEXANDRU HERA</span>
          <span class="wm-desc">SECURITY OPERATIONS</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .variant {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0 2rem;
  }

  .note {
    color: var(--fg-muted);
    font-size: 0.85rem;
    max-width: 34rem;
  }

  .stage {
    display: flex;
    align-items: center;
    gap: 3rem;
    flex-wrap: wrap;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
  }

  .mark-lg { height: 6.5rem; }
  .mark-sm { height: 3rem; flex-shrink: 0; }

  .stroke-fg { stroke: var(--fg); }
  .stroke-accent { stroke: var(--accent); }
  .fill-fg { fill: var(--fg); }
  .fill-accent { fill: var(--accent); }
  .fill-solid { fill: var(--fg); }
  .stroke-knockout { stroke: var(--bg-card); }

  .face-top { fill: var(--accent); opacity: 0.9; }
  .face-left { fill: var(--accent); opacity: 0.35; }
  .face-right { fill: var(--accent); opacity: 0.6; }

  .lockup-stack {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .wordmark-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-left: 1px solid var(--border);
    padding-left: 1.1rem;
  }

  .wm-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.28em;
    color: var(--fg);
    white-space: nowrap;
  }

  .wm-desc {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.62rem;
    letter-spacing: 0.42em;
    color: var(--fg-muted);
    white-space: nowrap;
  }
</style>
