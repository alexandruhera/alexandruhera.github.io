---
// SCRATCH PAGE — logo exploration v5: constructional complexity.
// Originals in brand/backup/. Not linked from nav. DELETE before launch.
import Base from "../layouts/Base.astro";
---

<Base title="Logo lab" description="Personal logo exploration — scratch page.">
  <h1>Logo lab <span class="mono-label">v5 — complexity by construction</span></h1>
  <p class="mono-label">no added elements — richer geometry: rotation depth, blade mechanics, engraving, encoding</p>

  <!-- A3: VORTEX — nine nested rotating layers -->
  <section class="variant">
    <h2>A3 — Aperture · Vortex</h2>
    <p class="note">
      One idea executed nine layers deep: each hexagon steps 7.5° of rotation and one
      weight down. The constant twist makes the edges form logarithmic spirals — the
      complexity is emergent, nothing is drawn except hexagons.
    </p>
    <div class="stage">
      <svg class="mark-lg" viewBox="0 0 52 56" xmlns="http://www.w3.org/2000/svg" aria-label="Vortex mark">
        <g fill="none">
          <path d="M26 4 L45.92 15.5 L45.92 38.5 L26 50 L6.08 38.5 L6.08 15.5 Z" style="stroke: var(--fg)" stroke-width="1.9"/>
          <g transform="rotate(7.5 26 27)"><path d="M26 7.7 L42.71 17.35 L42.71 36.65 L26 46.3 L9.29 36.65 L9.29 17.35 Z" style="stroke: var(--fg)" stroke-width="1.6" opacity="0.85"/></g>
          <g transform="rotate(15 26 27)"><path d="M26 10.8 L40.03 18.9 L40.03 35.1 L26 43.2 L11.97 35.1 L11.97 18.9 Z" style="stroke: var(--fg)" stroke-width="1.35" opacity="0.72"/></g>
          <g transform="rotate(22.5 26 27)"><path d="M26 13.4 L37.78 20.2 L37.78 33.8 L26 40.6 L14.22 33.8 L14.22 20.2 Z" style="stroke: var(--fg)" stroke-width="1.15" opacity="0.6"/></g>
          <g transform="rotate(30 26 27)"><path d="M26 15.6 L35.87 21.3 L35.87 32.7 L26 38.4 L16.13 32.7 L16.13 21.3 Z" style="stroke: var(--fg)" stroke-width="1" opacity="0.5"/></g>
          <g transform="rotate(37.5 26 27)"><path d="M26 17.4 L34.31 22.2 L34.31 31.8 L26 36.6 L17.69 31.8 L17.69 22.2 Z" style="stroke: var(--fg)" stroke-width="0.85" opacity="0.42"/></g>
          <g transform="rotate(45 26 27)"><path d="M26 18.95 L32.97 22.98 L32.97 31.03 L26 35.05 L19.03 31.03 L19.03 22.98 Z" style="stroke: var(--fg)" stroke-width="0.75" opacity="0.36"/></g>
          <g transform="rotate(52.5 26 27)"><path d="M26 20.25 L31.85 23.63 L31.85 30.38 L26 33.75 L20.15 30.38 L20.15 23.63 Z" style="stroke: var(--fg)" stroke-width="0.65" opacity="0.3"/></g>
          <g transform="rotate(60 26 27)"><path d="M26 21.35 L30.89 24.18 L30.89 29.83 L26 32.65 L21.11 29.83 L21.11 24.18 Z" style="stroke: var(--accent)" stroke-width="1.6"/></g>
        </g>
      </svg>
      <div class="lockup-stack">
        <svg class="mark-sm" viewBox="0 0 52 56" xmlns="http://www.w3.org/2000/svg">
          <g fill="none">
            <path d="M26 4 L45.92 15.5 L45.92 38.5 L26 50 L6.08 38.5 L6.08 15.5 Z" style="stroke: var(--fg)" stroke-width="2.4"/>
            <g transform="rotate(15 26 27)"><path d="M26 10.8 L40.03 18.9 L40.03 35.1 L26 43.2 L11.97 35.1 L11.97 18.9 Z" style="stroke: var(--fg)" stroke-width="1.2" opacity="0.55"/></g>
            <g transform="rotate(30 26 27)"><path d="M26 15.6 L35.87 21.3 L35.87 32.7 L26 38.4 L16.13 32.7 L16.13 21.3 Z" style="stroke: var(--accent)" stroke-width="2.6"/></g>
          </g>
        </svg>
        <div class="wordmark-block">
          <span class="wm-name">ALEXANDRU HERA</span>
          <span class="wm-desc">SECURITY OPERATIONS</span>
        </div>
      </div>
    </div>
  </section>

  <!-- A4: BLADES — filled aperture blades, negative-space core -->
  <section class="variant">
    <h2>A4 — Aperture · Blades</h2>
    <p class="note">
      Real camera-iris construction: six slanted blades in stepped accent tones close
      around a hexagonal opening. The core is pure negative space — the background is
      the "eye". Reads solid at avatar size; the tonal pinwheel appears up close.
    </p>
    <div class="stage">
      <svg class="mark-lg" viewBox="0 0 52 56" xmlns="http://www.w3.org/2000/svg" aria-label="Blades mark">
        <path d="M26 4 L45.92 15.5 L35 27 L30.5 19.21 Z" style="fill: var(--accent); opacity: 0.9"/>
        <path d="M45.92 15.5 L45.92 38.5 L30.5 34.79 L35 27 Z" style="fill: var(--accent); opacity: 0.5"/>
        <path d="M45.92 38.5 L26 50 L21.5 34.79 L30.5 34.79 Z" style="fill: var(--accent); opacity: 0.75"/>
        <path d="M26 50 L6.08 38.5 L17 27 L21.5 34.79 Z" style="fill: var(--accent); opacity: 0.4"/>
        <path d="M6.08 38.5 L6.08 15.5 L21.5 19.21 L17 27 Z" style="fill: var(--accent); opacity: 0.65"/>
        <path d="M6.08 15.5 L26 4 L30.5 19.21 L21.5 19.21 Z" style="fill: var(--accent); opacity: 0.3"/>
        <path d="M26 4 L45.92 15.5 L45.92 38.5 L26 50 L6.08 38.5 L6.08 15.5 Z" fill="none" style="stroke: var(--fg)" stroke-width="1.4"/>
      </svg>
      <div class="lockup-stack">
        <svg class="mark-sm" viewBox="0 0 52 56" xmlns="http://www.w3.org/2000/svg">
          <path d="M26 4 L45.92 15.5 L35 27 L30.5 19.21 Z" style="fill: var(--accent); opacity: 0.9"/>
          <path d="M45.92 15.5 L45.92 38.5 L30.5 34.79 L35 27 Z" style="fill: var(--accent); opacity: 0.5"/>
          <path d="M45.92 38.5 L26 50 L21.5 34.79 L30.5 34.79 Z" style="fill: var(--accent); opacity: 0.75"/>
          <path d="M26 50 L6.08 38.5 L17 27 L21.5 34.79 Z" style="fill: var(--accent); opacity: 0.4"/>
          <path d="M6.08 38.5 L6.08 15.5 L21.5 19.21 L17 27 Z" style="fill: var(--accent); opacity: 0.65"/>
          <path d="M6.08 15.5 L26 4 L30.5 19.21 L21.5 19.21 Z" style="fill: var(--accent); opacity: 0.3"/>
        </svg>
        <div class="wordmark-block">
          <span class="wm-name">ALEXANDRU HERA</span>
          <span class="wm-desc">SECURITY OPERATIONS</span>
        </div>
      </div>
    </div>
  </section>

  <!-- S3: ENGRAVED — triple-contour keyline -->
  <section class="variant">
    <h2>S3 — Signal · Engraved</h2>
    <p class="note">
      Banknote logic: the perimeter is three precisely offset contours in falling weights,
      and both signature moves — the broken segment and the accent edge — cascade through
      all three. Same silhouette as the original; triple the drawing.
    </p>
    <div class="stage">
      <svg class="mark-lg" viewBox="0 0 52 56" xmlns="http://www.w3.org/2000/svg" aria-label="Engraved mark">
        <g fill="none" stroke-linecap="round">
          <path d="M26 4 L45.92 15.5 L45.92 38.5 L26 50 L6.08 38.5 L6.08 21" style="stroke: var(--fg)" stroke-width="2"/>
          <path d="M26 6.2 L44.01 16.6 L44.01 37.4 L26 47.8 L7.99 37.4 L7.99 22.3" style="stroke: var(--fg)" stroke-width="1.1" opacity="0.75"/>
          <path d="M26 8 L42.45 17.5 L42.45 36.5 L26 46 L9.55 36.5 L9.55 23.2" style="stroke: var(--fg)" stroke-width="0.55" opacity="0.5"/>
          <path d="M6.08 15.5 L26 4" style="stroke: var(--accent)" stroke-width="2"/>
          <path d="M7.99 16.6 L26 6.2" style="stroke: var(--accent)" stroke-width="1.1" opacity="0.75"/>
          <path d="M9.55 17.5 L26 8" style="stroke: var(--accent)" stroke-width="0.55" opacity="0.5"/>
          <path d="M26 27 L26 12.5 M26 27 L37.5 33.6 M26 27 L15 33.3" style="stroke: var(--fg)" stroke-width="1" opacity="0.45"/>
        </g>
        <circle cx="26" cy="27" r="2.9" style="fill: var(--accent)"/>
        <circle cx="26" cy="27" r="4.7" fill="none" style="stroke: var(--accent)" stroke-width="0.6" opacity="0.5"/>
        <circle cx="26" cy="12.5" r="1.6" style="fill: var(--fg)"/>
        <circle cx="37.5" cy="33.6" r="1.6" style="fill: var(--fg)"/>
        <circle cx="15" cy="33.3" r="1.6" style="fill: var(--fg)" opacity="0.6"/>
      </svg>
      <div class="lockup-stack">
        <svg class="mark-sm" viewBox="0 0 52 56" xmlns="http://www.w3.org/2000/svg">
          <g fill="none" stroke-linecap="round">
            <path d="M26 4 L45.92 15.5 L45.92 38.5 L26 50 L6.08 38.5 L6.08 21" style="stroke: var(--fg)" stroke-width="2.6"/>
            <path d="M26 8 L42.45 17.5 L42.45 36.5 L26 46 L9.55 36.5 L9.55 23.2" style="stroke: var(--fg)" stroke-width="0.8" opacity="0.55"/>
            <path d="M6.08 15.5 L26 4" style="stroke: var(--accent)" stroke-width="2.6"/>
            <path d="M9.55 17.5 L26 8" style="stroke: var(--accent)" stroke-width="0.8" opacity="0.55"/>
          </g>
          <circle cx="26" cy="27" r="3.8" style="fill: var(--accent)"/>
        </svg>
        <div class="wordmark-block">
          <span class="wm-name">ALEXANDRU HERA</span>
          <span class="wm-desc">SECURITY OPERATIONS</span>
        </div>
      </div>
    </div>
  </section>

  <!-- S4: CIPHER — morse-encoded perimeter -->
  <section class="variant">
    <h2>S4 — Signal · Cipher</h2>
    <p class="note">
      The detail is <em>encoded</em>, not drawn: the top-right edge carries
      <span class="mono-inline">·− (A)</span> and the right edge
      <span class="mono-inline">···· (H)</span> in Morse, cut into the stroke itself.
      Invisible until someone looks closely — exactly the kind of detail a security
      audience loves finding.
    </p>
    <div class="stage">
      <svg class="mark-lg" viewBox="0 0 52 56" xmlns="http://www.w3.org/2000/svg" aria-label="Cipher mark">
        <g fill="none" stroke-linecap="round">
          <path d="M26 4 L45.92 15.5" style="stroke: var(--fg)" stroke-width="2.2" stroke-dasharray="2 2.4 7 30"/>
          <path d="M45.92 15.5 L45.92 38.5" style="stroke: var(--fg)" stroke-width="2.2" stroke-dasharray="2 2.4 2 2.4 2 2.4 2 30"/>
          <path d="M45.92 38.5 L26 50 L6.08 38.5 L6.08 21" style="stroke: var(--fg)" stroke-width="2.2"/>
          <path d="M6.08 15.5 L26 4" style="stroke: var(--accent)" stroke-width="2.2"/>
          <path d="M26 27 L26 12 M26 27 L38 34 M26 27 L14.5 33.5" style="stroke: var(--fg)" stroke-width="1.1" opacity="0.5"/>
        </g>
        <circle cx="26" cy="27" r="3.2" style="fill: var(--accent)"/>
        <circle cx="26" cy="12" r="1.7" style="fill: var(--fg)"/>
        <circle cx="38" cy="34" r="1.7" style="fill: var(--fg)"/>
        <circle cx="14.5" cy="33.5" r="1.7" style="fill: var(--fg)" opacity="0.6"/>
      </svg>
      <div class="lockup-stack">
        <svg class="mark-sm" viewBox="0 0 52 56" xmlns="http://www.w3.org/2000/svg">
          <g fill="none" stroke-linecap="round">
            <path d="M26 4 L45.92 15.5" style="stroke: var(--fg)" stroke-width="2.8" stroke-dasharray="2 2.4 7 30"/>
            <path d="M45.92 15.5 L45.92 38.5 L26 50 L6.08 38.5 L6.08 21" style="stroke: var(--fg)" stroke-width="2.8"/>
            <path d="M6.08 15.5 L26 4" style="stroke: var(--accent)" stroke-width="2.8"/>
          </g>
          <circle cx="26" cy="27" r="4" style="fill: var(--accent)"/>
        </svg>
        <div class="wordmark-block">
          <span class="wm-name">ALEXANDRU HERA</span>
          <span class="wm-desc">SECURITY OPERATIONS</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .variant {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0 2rem;
  }

  .note {
    color: var(--fg-muted);
    font-size: 0.85rem;
    max-width: 34rem;
  }

  .mono-inline {
    font-family: var(--font-mono);
    color: var(--fg);
  }

  .stage {
    display: flex;
    align-items: center;
    gap: 3rem;
    flex-wrap: wrap;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
  }

  .mark-lg { height: 6.5rem; }
  .mark-sm { height: 3rem; flex-shrink: 0; }

  .lockup-stack {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .wordmark-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-left: 1px solid var(--border);
    padding-left: 1.1rem;
  }

  .wm-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.28em;
    color: var(--fg);
    white-space: nowrap;
  }

  .wm-desc {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.62rem;
    letter-spacing: 0.42em;
    color: var(--fg-muted);
    white-space: nowrap;
  }
</style>
