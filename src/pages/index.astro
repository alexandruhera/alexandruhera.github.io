---
import Base from "../layouts/Base.astro";
---

<Base title="Alexandru Hera">
  <section class="hero">
    <p class="mono-label">// security operations &amp; threat detection</p>
    <h1>Security operations, <span class="accent">done properly</span>.</h1>
    <p class="lead">
      I lead Security Operations Centers for a living — building detection,
      triage, and incident response that holds up when it matters. I write
      about SOC operations, threat hunting, and the practical use of AI in
      security operations.
    </p>
    <div class="cta">
      <a class="btn btn-primary" href="/writing/">Read my writing</a>
      <a class="btn" href="/services/">Work with me</a>
    </div>
  </section>

  <div class="card-grid">
    <div class="card">
      <h3><span class="prefix">01</span>SOC leadership</h3>
      <p>
        Strategy, operations, quality assurance, and team development for
        managed and internal security operations.
      </p>
    </div>
    <div class="card">
      <h3><span class="prefix">02</span>Detection &amp; response</h3>
      <p>
        Threat detection engineering, incident response, and digital forensics
        across endpoint, cloud, and identity.
      </p>
    </div>
    <div class="card">
      <h3><span class="prefix">03</span>Security automation</h3>
      <p>
        Response workflows, playbooks, and AI-assisted operations that make
        small teams punch above their weight.
      </p>
    </div>
  </div>

  <p class="mono-label credentials">
    GSOM · GCFA · GCFR · GRTP · GIAC advisory board
  </p>
</Base>

<style>
  .hero {
    padding: 3rem 0 1.5rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 6vw, 2.7rem);
    margin: 0.6rem 0 1rem;
  }

  .accent {
    color: var(--accent);
  }

  .lead {
    color: var(--fg-muted);
    font-size: 1.02rem;
    max-width: 38rem;
  }

  .cta {
    display: flex;
    gap: 0.7rem;
    margin-top: 1.4rem;
    flex-wrap: wrap;
  }

  .credentials {
    display: block;
    margin-top: 2rem;
  }
</style>
