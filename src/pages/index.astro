---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base title="Alexandru Hera">
  <section class="hero">
    <p class="eyebrow">home</p>
    <h1>Security operations, <span class="accent">done properly</span>.</h1>
    <p class="lead">
      I lead Security Operations Centers for a living — building detection,
      triage, and incident response that holds up when it matters. I write
      about SOC operations, threat hunting, and the practical use of AI in
      security operations.
    </p>
    <div class="cta">
      <a class="btn btn-primary" href="/blog/">Read the blog</a>
      <a class="btn" href="/contact/">Work with me</a>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="latest">
        <p class="eyebrow">from the blog</p>
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              <span class="mono-label">
                {post.data.date.toISOString().slice(0, 10)}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  /* no top padding — the eyebrow lines up with every other page's header
     (main already supplies the top offset) */
  .hero {
    padding: 0 0 1.5rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 6vw, 2.7rem);
    margin: 0.6rem 0 1rem;
  }

  .accent {
    color: var(--accent);
  }

  .lead {
    color: var(--fg-muted);
    font-size: 1.02rem;
    max-width: 38rem;
  }

  .cta {
    display: flex;
    gap: 0.7rem;
    margin-top: 1.4rem;
    flex-wrap: wrap;
  }

  .latest {
    margin-top: 2.5rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0.8rem 0 0;
  }

  .post-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--border);
  }

  .post-list a {
    color: var(--fg);
  }

  .post-list a:hover {
    color: var(--accent);
    text-decoration: none;
  }
</style>
