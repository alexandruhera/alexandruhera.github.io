---
import ResumeTemplate from "../components/ResumeTemplate.astro";
import type { ResumeData } from "../components/ResumeTemplate.astro";

// dev vs prod boundary: the header contact block (location, phone, email,
// github, linkedin) is personal detail that belongs only in the PDF export,
// which is generated locally under `astro dev`. The published build
// (import.meta.env.DEV === false) drops it — the header keeps just the name,
// role eyebrow, and the Contact button (→ /contact/). GitHub + LinkedIn still
// live in the site footer.
const isDev = import.meta.env.DEV;

const data: ResumeData = {
  meta: {
    title: "Resume",
    description:
      "Alexandru Hera — Security Operations Center Manager. 8+ years in security operations. GSOM, GCFA, GCFR, GRTP.",
  },
  brand: { wordmark: ["alexandru", "hera"], tagline: "" },
  name: "Alexandru Hera",
  lead: "",
  location: isDev ? "Bucharest, Romania, 011354" : undefined,
  // Print button is a local-only tool for regenerating the PDF exports; the
  // live site ships without it (import.meta.env.DEV is false in the build).
  printButton: isDev,
  contact: isDev
    ? [
        { icon: "lucide:phone", label: "+40 721 812 347", href: "tel:+40721812347" },
        { icon: "lucide:mail", label: "contact@alexandruhera.com", href: "mailto:contact@alexandruhera.com" },
        { icon: "lucide:globe", label: "alexandruhera.com", href: "https://alexandruhera.com" },
        { icon: "lucide:github", label: "github", href: "https://github.com/alexandruhera" },
        { icon: "lucide:linkedin", label: "linkedin", href: "https://www.linkedin.com/in/alexandruhera" },
      ]
    : [],
  experience: [
    {
      period: "Jul 2025 — Present",
      title: "Security Operations Center Manager",
      company: "Beyond",
      current: true,
      points: [
        "Lead the SOC service and set its strategic and operational direction.",
        "Oversee SOC operations across log collection, threat detection, incident triage and response, reporting, quality assurance, and customer engagement.",
        "Write and maintain the SOC's security policies, standards, and governance frameworks.",
        "Mentor analysts and set development plans that grow the team's skills.",
      ],
    },
    {
      period: "Aug 2020 — Jul 2025",
      title: "Information Security Consultant",
      company: "MassMutual Romania",
      points: [
        "Responded to incidents using digital forensics and incident response (DFIR) principles and tooling such as EDR, SIEM, PAM, DLP, and cloud services.",
        "Documented and followed security operations processes, ran quality assurance, and mentored junior analysts.",
        "Automated response actions and built workflows and playbooks to improve SOC capabilities.",
        "Ran purple team exercises on the blue team alongside CrowdStrike, SpecterOps, and the internal offensive operations team.",
        "Maintained technical relationships with partner teams such as Endpoint Engineering, IAM, Cloud Security, and Fraud.",
      ],
    },
    {
      period: "Feb 2019 — Jul 2020",
      title: "Senior SOC Analyst",
      company: "SecureWorks",
      points: [
        "Investigated low to medium-severity incidents from multiple sources, such as AV/EDR, network, and email.",
        "Used indicators of compromise (IOCs) from internally produced cyber threat intelligence (CTI) reports to sweep the customer's environment.",
        "Recommended improvements to playbooks and procedures.",
      ],
    },
    {
      period: "Jul 2017 — Feb 2019",
      title: "Monitoring Analyst",
      company: "BRD Groupe Société Générale",
      points: [
        "Monitored the bank's critical infrastructure, responding to process warnings and escalating high to critical alerts.",
        "Provided operational support to bank employees.",
      ],
    },
  ],
  certifications: [
    {
      label: "Management",
      items: [
        {
          id: "GSOM",
          name: "GIAC Security Operations Manager",
          primary: true,
          skills: [
            "SOC strategy & design",
            "Team leadership & development",
            "Detection program management",
            "Threat-intel integration",
            "SOC metrics & KPIs",
            "SOC maturity assessment",
            "MITRE ATT&CK alignment",
          ],
        },
      ],
    },
    {
      label: "Forensics & Incident Response",
      items: [
        {
          id: "GCFA",
          name: "GIAC Certified Forensic Analyst",
          primary: true,
          skills: [
            "Enterprise incident response",
            "Threat hunting",
            "Windows forensics",
            "Memory forensics",
            "Timeline & super-timeline",
            "Anti-forensics detection",
            "Volatility",
            "KAPE",
            "Plaso",
          ],
        },
        {
          id: "GCFR",
          name: "GIAC Cloud Forensics Responder",
          primary: true,
          skills: [
            "Cloud incident response",
            "Microsoft 365 forensics",
            "Azure / Entra ID",
            "AWS & GCP log analysis",
            "Unified Audit Log",
            "OAuth & identity abuse",
            "CloudTrail",
          ],
        },
      ],
    },
    {
      label: "Offensive Security",
      items: [
        {
          id: "GRTP",
          name: "GIAC Red Team Professional",
          primary: true,
          skills: [
            "Red-team engagement planning",
            "Adversary emulation",
            "Active Directory attacks",
            "C2 infrastructure",
            "Lateral movement & persistence",
            "Defense evasion",
            "Cobalt Strike",
            "BloodHound",
          ],
        },
      ],
    },
    {
      label: "Foundations",
      items: [
        {
          id: "AWS",
          name: "AWS Certified Cloud Practitioner",
          skills: ["Cloud fundamentals", "AWS core services", "Shared-responsibility model", "Cost & billing"],
        },
        {
          id: "SEC+",
          name: "CompTIA Security+",
          skills: ["Network security", "Threats & attacks", "Cryptography", "Identity & access", "Risk & compliance"],
        },
        {
          id: "CCNA",
          name: "CCNA Routing and Switching",
          skills: ["Routing & switching", "Network fundamentals", "IP addressing", "Network security"],
        },
      ],
    },
  ],
  achievements: [
    {
      icon: "lucide:trophy",
      title: "Google Cloud Security MSSP of the Year (EMEA)",
      desc: "2026 Google Cloud Partner Award for Beyond's Google-centric agentic SOC.",
    },
    {
      icon: "lucide:award",
      title: "GIAC Advisory Board",
      desc: "Invited membership for top-percentile performance across GIAC exams.",
    },
  ],
  education: [
    {
      heading: "Education",
      items: [
        { icon: "lucide:graduation-cap", title: "Computing and IT (BSc)", sub: "University of Derby · 2022" },
        { icon: "lucide:graduation-cap", title: "Network Engineering (AP)", sub: "Danish Academy of Business and Technology · 2016" },
      ],
    },
    {
      heading: "Training",
      items: [
        { icon: "lucide:users", title: "SANS LDR551", sub: "Building and Leading Security Operations Centers" },
        { icon: "lucide:target", title: "SANS SEC565", sub: "Red Team Operations and Adversary Emulation" },
      ],
    },
  ],
};
---

<ResumeTemplate data={data} />
