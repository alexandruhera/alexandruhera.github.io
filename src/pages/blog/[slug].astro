---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection(
    "writing",
    ({ data }) => !data.draft || import.meta.env.DEV,
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const words = post.body?.split(/\s+/).length ?? 0;
const minutes = Math.max(1, Math.round(words / 220));
---

<Base title={post.data.title} description={post.data.description}>
  <article class="prose">
    <header class="post-header">
      <p class="eyebrow">blog</p>
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        {post.data.date.toISOString().slice(0, 10)} · {minutes} min read
      </p>
    </header>
    <Content />
  </article>
  <p class="back"><a href="/blog/">← Back to the blog</a></p>
</Base>

<style>
  .post-header {
    margin-bottom: 2rem;
  }

  .post-header h1 {
    margin: 0.5rem 0 0.6rem;
  }

  .post-meta {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--fg-muted);
    margin: 0;
  }

  .back {
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-nav);
  }
</style>
